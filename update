#/usr/bin/env bash
# Bash "strict mode"
set -euo pipefail
IFS=$'\n\t'

# Get reference commit
COMMIT=$(git rev-parse @)
git pull

# Update flake and commit on change
nix flake update
git diff --exit-code flake.lock || {
    git add flake.lock
    git cm "Update flake"
}

# Check if commit changed
UPDATED=$(git rev-parse @)
REMOTE=$(git rev-parse @{u})

# Rebuild and push
[[ "$COMMIT" != "$UPDATED" ]] || [[ "$COMMIT" != "$REMOTE" ]] && {
    if [[ $(uname -v) =~ "NixOS" ]]; then
        nh os switch
    else
        nh home switch
    fi

    git push
}
