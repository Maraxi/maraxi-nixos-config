#! /usr/bin/env nix-shell
#! nix-shell -i bash -p bash nvd
# shellcheck shell=bash

# Bash "strict mode"
set -euo pipefail
IFS=$'\n\t'

# debug
# set -x

# Get reference commit
git pull --no-tags
echo

# Update flake and commit on change
if [[ $(uname -v) =~ "NixOS" ]]; then
    nix flake update --commit-lock-file
else
    pre-commit install
    sudo /root/.nix-profile/bin/nix flake update --commit-lock-file
fi
echo

# Check if commit changed
CURRENT=$(git rev-parse @)

set +e  # do not fail if tag is missing
LAST_BUILD=$(git show-ref --hash --verify refs/tags/last-build 2>/dev/null)
TAG_EXISTS=$?
set -e

find-generation () {
    nixos-rebuild list-generations --json | jq '.[] | select(.current == true) | .generation'
}

# Rebuild and push
[[ "${TAG_EXISTS}" != 0 ]] || [[ "${CURRENT}" != "${LAST_BUILD}" ]] && {
    if [[ $(uname -v) =~ "NixOS" ]]; then
	prev_generation=$(find-generation)

        sudo true
        sudo nixos-rebuild switch --flake .
	echo

	nvd history --minimum-version "${prev_generation}"

	sleep 1.5
    else
        nh home switch
    fi
    echo

    git tag -f last-build
    git push
}
