#/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

COMMIT=$(git rev-parse @)
git pull
UPDATED=$(git rev-parse @{u})

nix flake update

{ [[ "$COMMIT" == "$UPDATED" ]] && git diff --exit-code flake.lock ; } || {
    git add flake.lock
    git cm "Update flake" || true

    if [[ $(uname -v) =~ "NixOS" ]]; then
	nh os switch
    else
	nh home switch
    fi

    git push
}
