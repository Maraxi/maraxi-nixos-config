#/usr/bin/env bash
# Bash "strict mode"
set -euo pipefail
IFS=$'\n\t'

# Get reference commit
git pull --no-tags

# Update flake and commit on change
root=$(git rev-parse --show-toplevel)
flakelock="$root/flake.lock"

nix flake update
git diff --exit-code "$flakelock" 1>/dev/null || {
    git add "$flakelock"
    pre-commit install
    git cm "Update flake"
}

# Check if commit changed
CURRENT=$(git rev-parse @)

set +e  # do not fail if tag is missing
LAST_BUILD=$(git show-ref --hash --verify refs/tags/last-build 2>/dev/null)
TAG_EXISTS=$?
set -e

# Rebuild and push
[[ $TAG_EXISTS != 0 ]] || [[ "$CURRENT" != "$LAST_BUILD" ]] && {
    if [[ $(uname -v) =~ "NixOS" ]]; then
        sudo true
        nh os switch
	sleep 1.5
    else
        nh home switch
    fi

    git tag -f last-build
    git push
}
