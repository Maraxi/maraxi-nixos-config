#!/usr/bin/env bash

# Bash "strict mode"
set -euo pipefail
IFS=$'\n\t'

# debug
# set -x

# Get reference commit
git pull --no-tags --autostash
echo

# Check for updates
if [[ $(hostname) == stefan-nixos ]]; then
  ROOT=$(git rev-parse --show-toplevel)
  LOCKED_REV=$(jq '.nodes.nixpkgs.locked.rev' "$ROOT/flake.lock")
  CURRENT_REV=$(curl -sL \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    https://api.github.com/repos/NixOS/nixpkgs/commits/nixos-unstable |
    jq '.sha')

  if [[ $LOCKED_REV != "$CURRENT_REV" ]]; then
    # Update flake and commit on change
    echo "Updating flake.lock"
    nix flake update --commit-lock-file
  fi
fi

# Check if commit changed
CURRENT=$(git rev-parse @)
REMOTE=$(git rev-parse "@{u}")

# Push any changes
[[ $CURRENT == "$REMOTE" ]] || git push

# empty if the tag is missing
LAST_BUILD=$(git rev-parse -q --verify refs/tags/last-build || true)

# Rebuild
if [[ $(uname -v) == *NixOS* ]]; then
  if [[ $CURRENT != "$LAST_BUILD" ]]; then
    action=${1:-switch}

    prev_system=$(readlink -f /run/current-system)

    sudo nixos-rebuild "$action" --flake "${NH_FLAKE:-.}"
    echo

    # `test` activates a new system without creating a generation, so compare store paths instead
    case $action in
      boot) new_system=/nix/var/nix/profiles/system ;;
      *) new_system=/run/current-system ;;
    esac
    current_system=$(readlink -f "$new_system")
    if [[ $prev_system != "$current_system" ]]; then
      dix "$prev_system" "$current_system"
      echo
    fi

    # Only tag when the configuration is persistent, so a later `update` still rebuilds after `test`/`build`
    case $action in
      switch | boot) git tag -f last-build ;;
    esac
  fi
else
  hm_profile="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/home-manager"
  function get_generation() {
    readlink "$hm_profile" | sed -E 's/.*-([0-9]+)-link/\1/'
  }

  prev_generation=$(get_generation)
  # Always switch here, the activation checks that the nvidia userspace driver matches the kernel module
  home-manager "${1:-switch}"

  current_generation=$(get_generation)
  if [[ $prev_generation != "$current_generation" ]]; then
    dix last --from "$prev_generation"
  fi
  git tag -f last-build
fi
