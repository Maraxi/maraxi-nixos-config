command = bash

quit-after-last-window-closed = false
shell-integration-features = ssh-env,ssh-terminfo,title

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 1m

theme = NightOwl
minimum-contrast = 1.5
background-opacity = 0.6
window-decoration = server

font-size = 12
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true

keybind = clear

keybind = ctrl+q=close_window
keybind = ctrl+shift+i=inspector:toggle
keybind = ctrl+shift+enter=new_window

keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+slash=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+c=copy_to_clipboard
keybind = unconsumed:ctrl+s=copy_url_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = ctrl+page_up=jump_to_prompt:-1
keybind = ctrl+page_down=jump_to_prompt:1
keybind = shift+page_up=scroll_page_fractional:-0.5
keybind = shift+page_down=scroll_page_fractional:0.5

keybind = ctrl+shift+f=start_search
keybind = chain=search_selection
keybind = unconsumed:escape=end_search

keybind = ctrl+shift+,=reload_config
