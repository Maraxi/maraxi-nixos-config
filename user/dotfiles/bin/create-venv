#! /usr/bin/env bash

[[ -f pyproject.toml ]] || { echo "pyproject.toml missing" && exit 1; }

uv venv

cat >.envrc <<-HERE
	export VIRTUAL_ENV=.venv
	[[ -d .venv ]] && layout python3
	dotenv_if_exists
HERE

uv sync --all-extras || { echo "Error when building current package. Did not allow the .envrc" && exit 1; }

direnv allow .envrc
