#!/usr/bin/env bash

set -euo pipefail

IFS=: read -ra man_dirs < <(manpath)

manpage=$(
  fd --print0 --follow --format '{/}' '\.(\d|gz)$' "${man_dirs[@]}" |
    sed --null-data --expression 's/\.gz$//' |
    sort --zero-terminated --unique |
    fzf --read0 --highlight-line --preview 'man {} 2>/dev/null'
)

man "$manpage"
