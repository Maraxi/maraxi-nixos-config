#!/usr/bin/env bash

set -euo pipefail

IFS=: read -ra data_dirs <<<"$XDG_DATA_DIRS"
IFS=: read -ra config_dirs <<<"$XDG_CONFIG_DIRS"

desktop_result=$(
  fd --follow --format '{/.};{}' '\.desktop$' \
    "$XDG_DATA_HOME"/applications "${data_dirs[@]}" \
    "$XDG_CONFIG_HOME"/autostart "${config_dirs[@]}" \
    2>/dev/null |
    column -ts ';' -o ' >' |
    sort -u |
    fzf --highlight-line --preview $'cat $(echo {} | awk -F ">" \'{print $2}\')'
)

desktop_file=$(echo "$desktop_result" | awk -F '>' '{print $2}')

"$EDITOR" "$desktop_file"
