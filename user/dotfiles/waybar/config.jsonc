{
  "layer": "top",
  "position": "top",
  // "height": 30,
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,

  "modules-left": [ "clock", "hyprland/workspaces", "hyprland/window" ],
  "modules-center": [],
  "modules-right": [ "hyprland/submap", "custom/recording", "privacy", "idle_inhibitor", "tray", "wireplumber", "network", "battery" ],

  "clock": {
    "interval": 5,
    "format": "  {:%H:%M:%S    %a, %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 4,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "hyprland/workspaces": {
    "all-outputs": false,
    // "format": "<sub>{icon}</sub>{windows}",
    // "window-rewrite-default": "",
    // "window-rewrite": {
      // "class<firefox>": "", // Windows whose classes are "firefox"
      // "alacritty": "", // Windows that contain "foot" in either class or title. For optimization reasons, it will only match against a title if at least one other window explicitly matches against a title.
      // "code": "󰨞",
    // },
  },

  "hyprland/submap": {
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.submap(\"reset\")'"
  },

  "hyprland/window": {
    "separate-outputs": true,
    "icon": true,
    "icon-size": 20,
    "max-length": 200,
    "rewrite": {
      "(.*) [-–] [^-–]*Edge$": "$1"
    }
  },

  // Hidden automatically on machines without a battery (desktop PC)
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-plugged": "\uf1e6 {capacity}%",
    "format-full": "\uf1e6 {capacity}%",
    "format-icons": [ "\uf244", "\uf243", "\uf242", "\uf241", "\uf240" ],
    "tooltip-format": "{timeTo}\n{power} W, health {health}%"
  },

  "privacy": {
    "icon-spacing": 4,
    "icon-size": 18,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare",},
      { "type": "audio-out", },
      { "type": "audio-in", }
    ]
  },

  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format": "{essid} ({frequency}GHz) - {ifname} via {gwaddr}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}:{essid} {ipaddr}/{cidr}"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "on-click": "ghostty +new-window -e wiremix",
    "format-icons": ["", "", ""]
  },

  // disabled
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "pamixer --default-source -t",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "scroll-step": 5
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    },
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  },

  "custom/recording": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/recording-status",
    "interval": 60,
    "signal": 12,
    "tooltip": true
  },
}
